# ============================================
# 航运智能账单助手 - 配置模板
# ============================================
# 复制此文件为 .env 并填写实际的API密钥

# ============================================
# 千问API配置（必需）
# ============================================
# 阿里云DashScope API密钥
DASHSCOPE_API_KEY=

# 模型名称（推荐使用qwen-max或qwen-plus）
QWEN_MODEL=qwen-max

# API基础URL（千问兼容OpenAI格式）
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ============================================
# 图片／扫描 PDF 识别（使用题方提供的公司 OCR）
# ============================================
# remote 使用题方 OCR_URL，file 参数为识别服务可访问的图片/PDF URL
# 不要求用户另行申请或配置视觉模型；不要假定接口支持本地路径/Base64
OCR_BACKEND=remote

# 主体业务策略：先使用明确方向／匹配旧账，再对缺方向的新账采用缺省值
DEFAULT_POSTING_TYPE=AR
# true：保留未映射费用原名并提示；false：要求人工确认内部标准费用代码
ALLOW_UNMAPPED_CHARGES=true

# ============================================
# 公司 OCR 接口（题目给定的 POST JSON 协议）
# ============================================
# OCR服务地址
OCR_URL=https://gateway.pltplt.com/ai/process

# OCR认证令牌（如需要）
OCR_TOKEN=

# OCR超时设置（秒）
OCR_TIMEOUT=300
OCR_CONNECT_TIMEOUT=10

# ============================================
# 阿里云 OSS 配置（图片/EML附件需要）
# 已有可访问 URL 可直接调用；本地文件需要先上传到 OSS
# ============================================
# 访问密钥（请替换为你的实际密钥）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# 地域节点（上海）
OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com

# Bucket 名称
OSS_BUCKET=ocr-phy

# ============================================
# LibreOffice配置（可选，用于旧版.doc转换）
# ============================================
SOFFICE_PATH=

# ============================================
# 调试和开发选项
# ============================================
# 是否启用调试模式
DEBUG=false

# 是否使用模拟数据（不调用真实API）
USE_MOCK_DATA=false

# 日志级别（DEBUG, INFO, WARNING, ERROR）
LOG_LEVEL=INFO

# 可选：授权的阿里云访问凭据CSV；完整环境变量凭据优先
OSS_CREDENTIALS_FILE=
