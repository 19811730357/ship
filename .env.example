# ============================================
# 航运智能账单助手 - 配置模板
# ============================================
# 复制此文件为 .env 并填写实际的API密钥

# ============================================
# 千问API配置（必需）
# ============================================
# 阿里云DashScope API密钥
DASHSCOPE_API_KEY=sk-ws-H.PRHMELR.U3IB.MEQCIBQ1hpxEyCBTmbMRElEmURErXlqm-mTy-2kkBnkF5KunAiArh6RQLXL_ZAerCmcxGYUMv8bqPLyhMvKJCYrNRi70EA

# 模型名称（推荐使用qwen-max或qwen-plus）
QWEN_MODEL=qwen-max

# API基础URL（千问兼容OpenAI格式）
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ============================================
# OCR服务配置（可选，用于PDF/图片识别）
# ============================================
# OCR服务地址
OCR_URL=https://gateway.pltplt.com/ai/process

# OCR认证令牌（如需要）
OCR_TOKEN=

# OCR超时设置（秒）
OCR_TIMEOUT=300
OCR_CONNECT_TIMEOUT=10

# ============================================
# 阿里云OSS配置（可选，用于PDF/图片上传）
# ============================================
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_BUCKET=

# ============================================
# LibreOffice配置（可选，用于旧版.doc转换）
# ============================================
SOFFICE_PATH=

# ============================================
# 调试和开发选项
# ============================================
# 是否启用调试模式
DEBUG=false

# 是否使用模拟数据（不调用真实API）
USE_MOCK_DATA=false

# 日志级别（DEBUG, INFO, WARNING, ERROR）
LOG_LEVEL=INFO
