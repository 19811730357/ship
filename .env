# ============================================
# 航运智能账单助手 - 配置模板
# ============================================
# 复制此文件为 .env 并填写实际的API密钥

# ============================================
# 千问API配置（必需）
# ============================================
# 阿里云DashScope API密钥
DASHSCOPE_API_KEY={DASHSCOPE_API_KEY}

# 模型名称（使用 qwen-long 支持更长上下文）
QWEN_MODEL=qwen-long

# API基础URL（千问兼容OpenAI格式）
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ============================================
# 数据库配置（新增）
# ============================================
# 数据库类型: sqlite, mysql, postgres

# 使用 SQLite（默认，无需配置MySQL）
# DB_TYPE=sqlite
# DB_DATABASE=billing.db

# 使用 MySQL（连接你的 ship 数据库）
# 已启用 MySQL
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ship
DB_USER=root
DB_PASSWORD=root

# ============================================
# OCR服务配置（可选，用于PDF/图片识别）
# ============================================
# OCR服务地址
OCR_URL=https://gateway.pltplt.com/ai/process

# OCR认证令牌（如需要）
OCR_TOKEN=

# OCR超时设置（秒）
OCR_TIMEOUT=300
OCR_CONNECT_TIMEOUT=10

# ============================================
# 阿里云OSS配置（已配置完成）
# ============================================
OSS_ACCESS_KEY_ID={OSS_ACCESS_KEY_ID}
OSS_ACCESS_KEY_SECRET={OSS_ACCESS_KEY_SECRET}
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
OSS_BUCKET=ocr-phy

# ============================================
# LibreOffice配置（可选，用于旧版.doc转换）
# ============================================
SOFFICE_PATH=

# ============================================
# 调试和开发选项
# ============================================
# 是否启用调试模式
DEBUG=false

# 是否使用模拟数据（不调用真实API）
USE_MOCK_DATA=false

# 日志级别（DEBUG, INFO, WARNING, ERROR）
LOG_LEVEL=INFO
OCR_BACKEND=remote
OSS_CREDENTIALS_FILE=D:/桌面/湃乐多笔试题/V4版本/.secrets/oss-credentials.csv
